          "http": {
            "method": "DELETE",
            "url": "https://open.bohrium.com/openapi/v2/ds/:id/version/:version_id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "删除版本"
        },
        {
          "info": {
            "name": "创建数据集（结尾斜杠必需）",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://open.bohrium.com/openapi/v2/ds/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "创建数据集（结尾斜杠必需）"
        },
        {
          "info": {
            "name": "上传后提交",
            "type": "http"
