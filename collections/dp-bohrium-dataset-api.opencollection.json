{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bohrium Open AI 科学小导师 (bohrium-mentor) AI 科学小导师 (bohrium-mentor) 数据集 (bohrium-dataset) API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "数据集 (bohrium-dataset)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "数据集详情",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://open.bohrium.com/openapi/v2/ds/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "数据集详情"
        },
        {
          "info": {
            "name": "更新数据集信息",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://open.bohrium.com/openapi/v2/ds/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "更新数据集信息"
        },
        {
          "info": {
            "name": "版本列表",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://open.bohrium.com/openapi/v2/ds/:id/version",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "版本列表"
        },
        {
          "info": {
            "name": "创建新版本",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://open.bohrium.com/openapi/v2/ds/:id/version",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "创建新版本"
        },
        {
          "info": {
            "name": "版本详情",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://open.bohrium.com/openapi/v2/ds/:id/version/:version_id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "版本详情"
        },
        {
          "info": {
            "name": "删除版本",
            "type": "http"
