                "name": "projectId",
                "value": "",
                "type": "query"
              },
              {
                "name": "path",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "获取上传 token"
        },
        {
          "info": {
            "name": "数据集权限",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://open.bohrium.com/openapi/v2/ds/:id/permission",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "数据集权限"
        },
        {
          "info": {
            "name": "关联项目",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://open.bohrium.com/openapi/v2/ds/project"
