            "url": "https://open.bohrium.com/openapi/v2/ds/commit",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "上传后提交"
        },
        {
          "info": {
            "name": "配额检查",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://open.bohrium.com/openapi/v2/ds/quota/check",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "配额检查"
        },
        {
