{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bohrium Open AI 科学小导师 (bohrium-mentor) AI 科学小导师 (bohrium-mentor) 容器镜像 (bohrium-image) API",
    "version": "2.0.0"
  },
  "request": {
